            if v then
                if not hookActive then
                    local success = setupTouchSensitivity()
                    if success then
                        Window:Notify({Title = "SENSIBILIDADE", Desc = "Sensibilidade ativada!", Time = 2})
                    else
                        Window:Notify({Title = "SENSIBILIDADE", Desc = "Falha ao ativar", Time = 2})
                    end
                else
                    Window:Notify({Title = "SENSIBILIDADE", Desc = "Sensibilidade ativada!", Time = 2})
                end
            else
                Window:Notify({Title = "SENSIBILIDADE", Desc = "Sensibilidade desativada!", Time = 2})
            end
        end
    })
    
    FPSBoost:Slider({
        Title = "SENSIBILIDADE",
