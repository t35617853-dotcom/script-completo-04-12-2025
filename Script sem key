local function startColorSkill()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player then saveGKColors(p) end
    end
    pcall(function()
        local r = math.floor(selectedColor.R * 255)
        local g = math.floor(selectedColor.G * 255)
        local b = math.floor(selectedColor.B * 255)
        player.Ego.Value = r .. "," .. g .. "," .. b
    end)
    pcall(function()
        local flowBar = player.PlayerGui:WaitForChild("MainmenuGui"):WaitForChild("Frame2"):WaitForChild("Flow-bar-inside")
        flowBar.BackgroundColor3 = getChosenColor()
        flowBar.BorderColor3 = getChosenColor()
    end)
    task.spawn(function()
        while colorSkillEnabled do
            pcall(function()
                local r = math.floor(selectedColor.R * 255)
                local g = math.floor(selectedColor.G * 255)
                local b = math.floor(selectedColor.B * 255)
                local val = r .. "," .. g .. "," .. b
                if player.Ego.Value ~= val then player.Ego.Value = val end
            end)
            pcall(function()
                local gui = player.PlayerGui:FindFirstChild("MainmenuGui")
                if gui then
                    local f2 = gui:FindFirstChild("Frame2")
                    if f2 then
                        local fb = f2:FindFirstChild("Flow-bar-inside")
                        if fb then fb.BackgroundColor3 = getChosenColor() fb.BorderColor3 = getChosenColor() end
                    end
                end
            end)
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= player and isPlayerGK(p) then restoreGKColors(p) end
            end
            task.wait(0.3)
        end
    end)
    task.spawn(function()
        local char = player.Character
        if char then
            for _, v in pairs(char:GetDescendants()) do
                if colorSkillEnabled and isEffectObj(v) then applyToEffect(v) end
            end
        end
    end)
    local myChar = player.Character
    if myChar then
        local myConn = myChar.DescendantAdded:Connect(function(v)
            if colorSkillEnabled and isEffectObj(v) then task.defer(function() applyToEffect(v) end) end
        end)
        table.insert(colorConnections, myConn)
    end
    local ballConn = Workspace.DescendantAdded:Connect(function(v)
        if colorSkillEnabled and isEffectObj(v) then task.defer(function() applyColorToObj(v) end) end
    end)
    table.insert(colorConnections, ballConn)
    local newBallConn = Workspace.ChildAdded:Connect(function(child)
        if child.Name:lower() == "ball" then
            task.wait(0.1)
            for _, v in pairs(child:GetDescendants()) do
                if colorSkillEnabled and isEffectObj(v) then applyColorToObj(v) end
            end
        end
    end)
    table.insert(colorConnections, newBallConn)
    local respawnConn = player.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        for _, v in pairs(char:GetDescendants()) do
            if colorSkillEnabled and isEffectObj(v) then applyToEffect(v) end
        end
        local newMyConn = char.DescendantAdded:Connect(function(v)
            if colorSkillEnabled and isEffectObj(v) then task.defer(function() applyToEffect(v) end) end
        end)
        table.insert(colorConnections, newMyConn)
    end)
    table.insert(colorConnections, respawnConn)
end

local function stopColorSkill()
    for _, c in pairs(colorConnections) do
        pcall(function() if typeof(c) == "RBXScriptConnection" then c:Disconnect() end end)
    end
    colorConnections = {}
    myGoalActive = false
    pcall(function() player.Ego.Value = "NONE" end)
    pcall(function()
        local gui = player.PlayerGui:FindFirstChild("MainmenuGui")
        if gui then
            local f2 = gui:FindFirstChild("Frame2")
            if f2 then
                local fb = f2:FindFirstChild("Flow-bar-inside")
                if fb then fb.BackgroundColor3 = Color3.fromRGB(255, 200, 0) fb.BorderColor3 = Color3.fromRGB(255, 200, 0) end
            end
        end
    end)
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player then restoreGKColors(p) end
    end
end

