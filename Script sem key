local function isMyChar(v)
	local char = player.Character
	return char ~= nil and v:IsDescendantOf(char)
end

local function isBallAndMine(v)
	local p = v.Parent
	while p and p ~= Workspace do
		if p.Name:lower() == "ball" then
			local ball = p
			local char = player.Character
			if char then
				local hrp = char:FindFirstChild("HumanoidRootPart")
				if hrp and ball:IsA("BasePart") then
					local dist = (hrp.Position - ball.Position).Magnitude
					if dist <= 15 then return true end
				end
			end
			return false
		end
		p = p.Parent
	end
	return false
end

local function isOtherPlayer(v)
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= player and p.Character and v:IsDescendantOf(p.Character) then
			return true, p
		end
	end
	return false, nil
end

local function isPlayerGK(p)
	if not p or not p.Character then return false end
	local char = p.Character
	if char:GetAttribute("IsGK") or char:GetAttribute("GK") or char:GetAttribute("Goalkeeper") then return true end
	local pname = p.Name:lower()
	if pname:find("gk") or pname:find("keeper") or pname:find("goleiro") then return true end
	local role = char:FindFirstChild("Role") or char:FindFirstChild("Position") or char:FindFirstChild("GK")
	if role then
		local val = tostring(role.Value or role.Name):lower()
		if val:find("gk") or val:find("keeper") or val:find("goalkeeper") then return true end
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		local dn = hum.DisplayName:lower()
		if dn:find("gk") or dn:find("keeper") then return true end
	end
	for _, child in pairs(char:GetChildren()) do
		if child.Name:lower() == "gk" or child.Name:lower() == "goalkeeper" then return true end
	end
	return false
end

local function saveGKColors(p)
	if not p or not p.Character then return end
	if not isPlayerGK(p) then return end
	local char = p.Character
	local uid = p.UserId
	gkOriginalColors[uid] = {}
	for _, v in pairs(char:GetDescendants()) do
		pcall(function()
			if v:IsA("ParticleEmitter") then
				gkOriginalColors[uid][v] = {type="particle", Color=v.Color, LightEmission=v.LightEmission, Transparency=v.Transparency}
			elseif v:IsA("Trail") then
				gkOriginalColors[uid][v] = {type="trail", Color=v.Color, LightEmission=v.LightEmission, Transparency=v.Transparency}
			elseif v:IsA("Beam") then
				gkOriginalColors[uid][v] = {type="beam", Color=v.Color, LightEmission=v.LightEmission, Transparency=v.Transparency}
			elseif v:IsA("Highlight") then
				gkOriginalColors[uid][v] = {type="highlight", FillColor=v.FillColor, OutlineColor=v.OutlineColor, FillTransparency=v.FillTransparency, OutlineTransparency=v.OutlineTransparency}
			end
		end)
	end
end

local function restoreGKColors(p)
	if not p then return end
	local uid = p.UserId
	if not gkOriginalColors[uid] then return end
	for obj, data in pairs(gkOriginalColors[uid]) do
		pcall(function()
			if not obj or not obj.Parent then return end
			if data.type == "particle" then obj.Color = data.Color obj.LightEmission = data.LightEmission obj.Transparency = data.Transparency
			elseif data.type == "trail" then obj.Color = data.Color obj.LightEmission = data.LightEmission obj.Transparency = data.Transparency
			elseif data.type == "beam" then obj.Color = data.Color obj.LightEmission = data.LightEmission obj.Transparency = data.Transparency
			elseif data.type == "highlight" then obj.FillColor = data.FillColor obj.OutlineColor = data.OutlineColor obj.FillTransparency = data.FillTransparency obj.OutlineTransparency = data.OutlineTransparency
			end
		end)
	end
end

local function isEffectObj(v)
	return v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") or v:IsA("Highlight")
end

local function applyToEffect(v)
	pcall(function()
		if v:IsA("ParticleEmitter") then
			v.Color = getChosenSeq() v.LightEmission = 0 v.LightInfluence = 1 v.Transparency = NumberSequence.new(0)
		elseif v:IsA("Trail") then
			v.Color = getChosenSeq() v.LightEmission = 0 v.Transparency = NumberSequence.new(0)
		elseif v:IsA("Beam") then
			v.Color = getChosenSeq() v.LightEmission = 0 v.Transparency = NumberSequence.new(0)
		elseif v:IsA("Highlight") then
			v.FillColor = getChosenColor() v.OutlineColor = getChosenColor()
			v.FillTransparency = 0.3 v.OutlineTransparency = 0
		end
	end)
end

local myGoalActive = false

local function applyColorToObj(v)
	if not v or not v.Parent then return end
	local isOther, otherP = isOtherPlayer(v)
	if isOther then
		if otherP and isPlayerGK(otherP) then restoreGKColors(otherP) end
		return
	end
	if isMyChar(v) then applyToEffect(v) return end
	if isBallAndMine(v) then applyToEffect(v) return end
	if myGoalActive then
		local vname = v.Name:lower()
		local pname = v.Parent and v.Parent.Name:lower() or ""
		if vname:find("goal") or vname:find("explosion") or pname:find("goal") or pname:find("explosion") then
			applyToEffect(v)
		end
	end
end

