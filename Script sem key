    FPSBoost:Section({Title = "CAMERA"})
    
    local SensitivityEnabled = false
    local currentSensitivity = 1
    local cameraInputModule = nil
    local hookActive = false
    
    local function setupTouchSensitivity()
        local UserInputService = game:GetService("UserInputService")
        local success = false
        
        pcall(function()
            local playerScripts = player:FindFirstChild("PlayerScripts")
            if not playerScripts then return end
            
            local playerModule = playerScripts:FindFirstChild("PlayerModule")
            if not playerModule then return end
            
            local cameraModule = playerModule:FindFirstChild("CameraModule")
            if cameraModule then
                local cameraInput = cameraModule:FindFirstChild("CameraInput")
                if cameraInput then
                    cameraInputModule = require(cameraInput)
                    if cameraInputModule and cameraInputModule.getRotation then
                        local originalGetRotation = cameraInputModule.getRotation
                        cameraInputModule.getRotation = function(disableRotation)
                            local rotation = originalGetRotation(disableRotation)
                            if UserInputService.TouchEnabled and SensitivityEnabled then
                                return rotation * currentSensitivity
                            end
                            return rotation
                        end
                        success = true
                        hookActive = true
                    end
                end
            end
        end)
        
        if not success then
            pcall(function()
                local oldIndex
                oldIndex = hookmetamethod(game, "__index", function(self, key)
                    if self == UserInputService and key == "MouseDelta" and UserInputService.TouchEnabled and SensitivityEnabled then
                        local original = oldIndex(self, key)
                        return original * currentSensitivity
                    end
                    return oldIndex(self, key)
                end)
                success = true
                hookActive = true
            end)
        end
        
        return success
    end
    
    FPSBoost:Toggle({
        Title = "SENSIBILIDADE",
        Desc = "info: mude a sensibilidade do seu toque",
        Value = false,
        Callback = function(v)
